rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Coleção de usuários e patentes (/usuarios/{userId})
    // Leitura liberada para carregar em tempo real quem possui cada Patente (Coordenador, Gestor, Colaborador) no banco
    match /usuarios/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Estado em tempo real do sistema (/front30/{docId})
    match /front30/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Demais coleções do sistema
    match /{document=**} {
      allow read, write: if isVerifiedUser();
    }
  }
}
