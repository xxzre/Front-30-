rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar: verifica se o usuário está logado e com o e-mail verificado
    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Coleção de perfil individual em tempo real do usuário (/usuarios/{userId})
    match /usuarios/{userId} {
      // Permite criar e atualizar o próprio perfil se autenticado e for o próprio uid
      allow create, read, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Coleção de dados em tempo real do Front 30' (/front30/{docId})
    // Garante sincronização em tempo real sem perda de dados ao atualizar a página
    match /front30/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Demais coleções do sistema
    match /{document=**} {
      allow read, write: if isVerifiedUser();
    }
  }
}
