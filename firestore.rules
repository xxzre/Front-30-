rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar: verifica se o usuário está logado e com o e-mail verificado
    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Função auxiliar: verifica se o papel (nível hierárquico) é válido
    function isValidRole(papel) {
      return papel in ['coordenador', 'gestor', 'colaborador'];
    }

    // Coleção de perfil inicial e hierarquia do usuário (/usuarios/{userId})
    match /usuarios/{userId} {
      // Permite criar o documento inicial no cadastro se autenticado, for o próprio uid e papel válido
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && isValidRole(request.resource.data.papel);

      // Bloqueia leitura de perfis de terceiros: apenas o próprio usuário verificado pode ler seu perfil
      allow read: if isVerifiedUser() && request.auth.uid == userId;

      // Impede escalação de privilégio: o usuário não pode alterar seu próprio nível hierárquico (papel) após criado
      allow update: if isVerifiedUser()
                    && request.auth.uid == userId
                    && request.resource.data.papel == resource.data.papel;

      allow delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Coleção de dados em tempo real do Front 30' (/front30/{docId})
    match /front30/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Demais coleções do sistema
    // Leituras e escritas normais exigem usuário autenticado E com e-mail verificado
    match /{document=**} {
      allow read, write: if isVerifiedUser();
    }
  }
}
