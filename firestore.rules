rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar: verifica se o usuário está logado e com o e-mail verificado
    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Coleção de perfil inicial do usuário (/usuarios/{userId})
    match /usuarios/{userId} {
      // Permite criar o documento inicial no cadastro se autenticado e for o próprio uid
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Permite leitura, atualização e exclusão após confirmar o e-mail (para o próprio usuário)
      allow read, update, delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Coleção de dados em tempo real do Front 30' (/front30/{docId})
    // Garante que o selo "● FIRESTORE ONLINE" e a sincronização de dados funcionem
    // assim que o usuário autenticado acessar o painel
    match /front30/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Demais coleções do sistema
    // Leituras e escritas normais exigem usuário autenticado E com e-mail verificado
    match /{document=**} {
      allow read, write: if isVerifiedUser();
    }
  }
}
